use flake

# Build ssmux into .direnv/ssmux and expose it on PATH.
# Rebuilds when Go sources or the flake change.
watch_file flake.nix flake.lock go.mod go.sum $(find . -name '*.go' -not -path './.direnv/*')
if nix build .#ssmux --out-link .direnv/ssmux; then
  PATH_add .direnv/ssmux/bin
else
  log_error "ssmux build failed"
fi
